+    /*
+     * SafeSafar patch: autoSend rewritten for Android 12-15.
+     *  - PendingIntents are FLAG_IMMUTABLE (required when targeting Android 12+).
+     *  - The "sent" receiver is registered NOT_EXPORTED on Android 13+, listens for a unique
+     *    action per call, and is always unregistered.
+     *  - Callbacks are per call, so several sends in a row cannot overwrite each other.
+     *  - A timeout makes sure JS always gets an answer.
+     *  - No write to content://sms/sent: only the default SMS app may do that, and the
+     *    SecurityException made every send report a failure after the message was sent.
+     */
+    private class SendWatcher extends BroadcastReceiver implements Runnable {
+        private final AtomicBoolean finished = new AtomicBoolean(false);
+        private final Handler handler = new Handler(Looper.getMainLooper());
+        private final Callback errorCallback;
+        private final Callback successCallback;
+        private final int total;
+        private int sentParts = 0;
+
+        SendWatcher(int total, Callback errorCallback, Callback successCallback) {
+            this.total = total;
+            this.errorCallback = errorCallback;
+            this.successCallback = successCallback;
+        }
+
+        void start(IntentFilter filter) {
+            if (Build.VERSION.SDK_INT >= 33) {
+                context.registerReceiver(this, filter, Context.RECEIVER_NOT_EXPORTED);
+            } else {
+                context.registerReceiver(this, filter);
+            }
+            handler.postDelayed(this, 30000);
+        }
+
+        @Override
+        public void onReceive(Context c, Intent intent) {
+            int code = getResultCode();
+            if (code == Activity.RESULT_OK) {
+                sentParts++;
+                if (sentParts >= total) {
+                    finish(true, "SMS sent");
+                }
+            } else {
+                finish(false, describe(code));
+            }
+        }
+
+        @Override
+        public void run() {
+            finish(false, "Timed out waiting for send confirmation");
+        }
+
+        void finish(boolean ok, String message) {
+            if (!finished.compareAndSet(false, true)) {
+                return;
+            }
+            handler.removeCallbacks(this);
+            try {
+                context.unregisterReceiver(this);
+            } catch (Exception ignored) {
+            }
+            if (ok) {
+                successCallback.invoke(message);
+            } else {
+                errorCallback.invoke(message);
+            }
+        }
+    }
+
+    private static String describe(int code) {
+        switch (code) {
+            case SmsManager.RESULT_ERROR_GENERIC_FAILURE:
+                return "Generic failure";
+            case SmsManager.RESULT_ERROR_NO_SERVICE:
+                return "No service";
+            case SmsManager.RESULT_ERROR_NULL_PDU:
+                return "Null PDU";
+            case SmsManager.RESULT_ERROR_RADIO_OFF:
+                return "Radio off";
+            default:
+                return "SMS send failed (code " + code + ")";
+        }
+    }
 
