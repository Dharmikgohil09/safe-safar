# ====================================================================
# SafeSafar Flutter Environment Variables
# ====================================================================

# 1. SafeSafar Backend API URL
API_BASE_URL=https://safesafar-backend.onrender.com

# 2. Map Configuration
# Note: Flutter Map uses OpenStreetMap tiles by default (no API key needed).
# If using Google Maps SDK (google_maps_flutter):
# Apply the key in android/app/src/main/AndroidManifest.xml under com.google.android.geo.API_KEY
# and in ios/Runner/AppDelegate.swift under GMSServices.provideAPIKey("YOUR_KEY")
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Mapbox / Custom Tile Template (Optional)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
