# SafeSafar Live Tracker - Environment Configuration
# Copy to .env.local for local overrides (never commit .env.local)

# Backend WebSocket URL (Socket.IO server)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Backend REST API base URL (for token session validation if available)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Enable Mock Mode for independent local development and demo testing
# Set to 'true' to simulate real-time GPS telemetry without an active backend
# Set to 'false' in production or when connected to the SafeSafar backend
NEXT_PUBLIC_MOCK_MODE=true

# Optional: Custom map tile provider URL (defaults to OpenStreetMap tiles, no API key needed)
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
