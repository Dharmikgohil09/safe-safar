# ====================================================================
# SafeSafar Mobile Environment Variables Configuration
# Copy this file to .env:  cp .env.example .env
# ====================================================================

# 1. SafeSafar Backend API URL
EXPO_PUBLIC_API_URL=https://safesafar-backend.onrender.com

# 2. Map Configuration
# NOTE: The map works 100% OUT-OF-THE-BOX with FREE OpenStreetMap & CartoDB tiles.
# You DO NOT need to purchase or apply a paid API key unless you specifically
# wish to use Google Maps SDK or Mapbox vector tiles.

# [OPTIONAL] Google Maps API Key:
# Used if you build with react-native-maps native Google Maps provider or Google Places API.
# Note: For native Android/iOS builds, also apply in app.json under:
#   expo.android.config.googleMaps.apiKey
#   expo.ios.config.googleMaps.apiKey
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# [OPTIONAL] Mapbox Access Token:
# If provided, SafeSafar automatically switches to crisp Mapbox Street & Satellite tiles.
# Get your free token at: https://account.mapbox.com
EXPO_PUBLIC_MAPBOX_TOKEN=

# [OPTIONAL] Custom Tile URL Template (Slippy Map format {z}/{x}/{y})
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_URL=

# [OPTIONAL] Live Routing Engine URL (OSRM / OpenRouteService)
EXPO_PUBLIC_ROUTING_API_URL=https://router.project-osrm.org

# [OPTIONAL] Hackathon Demo Mode
# Set to 'true' to force-load the pre-seeded Surat SVNIT -> Adajan Gam scenario on launch.
# Defaults to 'false', which uses your device's REAL live GPS location.
EXPO_PUBLIC_DEMO_MODE=false

# 3. Live Guardian Web Tracker URL
# For local browser testing on the same machine, use http://localhost:3000.
# If testing from an external physical phone on the same Wi-Fi, set to http://<YOUR_LAN_IP>:3000
EXPO_PUBLIC_TRACKER_URL=http://localhost:3000
