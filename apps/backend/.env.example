# SafeSafar Backend Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/safesafar?retryWrites=true&w=majority

# JWT Authentication Secret and Expiry
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins, or * in dev)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# External Service Placeholders for Teammate Modules
ORS_API_KEY=your_openrouteservice_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
FCM_SERVER_KEY=your_fcm_server_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone
